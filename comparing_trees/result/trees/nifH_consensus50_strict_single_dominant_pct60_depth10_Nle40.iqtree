iqtree -s /mnt/dv/wid/projects6/SolisLemus-Intbio-raw/processed-data/symbiosis_sorted_v2_consensus_sequences_50percent/nifH_consensus_mafft_pct60_depth10_Nle40_v2/nifH_consensus50_strict_single_dominant_pct60_depth10_Nle40.mafft.fasta --alisim mimicked_MSA

